# ---- Public (bundled into the app; safe only because RLS + key restrictions protect them) ----
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_…), from Dashboard → Project Settings → API Keys
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Mappls map SDK key — restrict it in the Mappls console to your Android package, iOS bundle id and web domain
EXPO_PUBLIC_MAPPLS_MAP_SDK_KEY=
EXPO_PUBLIC_APP_ENV=development   # development | staging | production
# Store listings shown on S4 "Trips run on the mobile app" (leave empty until published)
EXPO_PUBLIC_PLAY_STORE_URL=
EXPO_PUBLIC_APP_STORE_URL=
# Privacy policy linked from the D1 location screen (docs/09 §6); link hidden while empty
EXPO_PUBLIC_PRIVACY_POLICY_URL=
# Sentry DSN for crash reports (native + web). Empty = reporting off. PII is scrubbed on the device (src/lib/scrub.ts)
EXPO_PUBLIC_# Source-map upload at build time only (EAS secret / CI env), never in the app bundle:
# SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT — see docs/HARDENING_REPORT.md §3
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Dev only: preview the driver app in the browser with simulated GPS/permissions (see DEV_SETUP §8)
EXPO_PUBLIC_DEV_DRIVER_WEB=
# Local Supabase (`npx supabase start`): URL http://127.0.0.1:54321 and the PUBLISHABLE_KEY it prints

# ---- Server-only (Supabase Edge Function secrets — NEVER in the app bundle) ----
# set with: supabase secrets set KEY=value
# Static REST key used by mappls-proxy (sent as access_token). See supabase/functions/mappls-proxy/README.md
MAPPLS_REST_KEY=
# Optional: planned-distance routing profile, trucking (default) | driving
MAPPLS_ROUTE_PROFILE=
# OAuth client credentials: only for premium Mappls APIs (Legacy auth); not used in Phase 1
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY(S), SUPABASE_SECRET_KEY(S) and the JWKS are injected into
# Edge Functions automatically (hosted and `supabase functions serve`). Set them by hand only when
# running a function outside Supabase. The secret key (sb_secret_…) never goes in the app.
# Source-map upload at build time only (EAS secret / CI env), never in the app bundle:
# SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT — see docs/HARDENING_REPORT.md §3
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
