# ---- Public (bundled into the app; safe only because RLS + key restrictions protect them) ----
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Mappls map SDK key — restrict it in the Mappls console to your Android package, iOS bundle id and web domain
EXPO_PUBLIC_MAPPLS_MAP_SDK_KEY=
EXPO_PUBLIC_APP_ENV=development   # development | staging | production
# Store listings shown on S4 "Trips run on the mobile app" (leave empty until published)
EXPO_PUBLIC_PLAY_STORE_URL=
EXPO_PUBLIC_APP_STORE_URL=
# Local Supabase (`npx supabase start`): URL http://127.0.0.1:54321 and the ANON_KEY it prints

# ---- Server-only (Supabase Edge Function secrets — NEVER in the app bundle) ----
# set with: supabase secrets set KEY=value
# Static REST key used by mappls-proxy (sent as access_token). See supabase/functions/mappls-proxy/README.md
MAPPLS_REST_KEY=
# Optional: planned-distance routing profile, trucking (default) | driving
MAPPLS_ROUTE_PROFILE=
# OAuth client credentials: only for premium Mappls APIs (Legacy auth); not used in Phase 1
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SENTRY_DSN=
