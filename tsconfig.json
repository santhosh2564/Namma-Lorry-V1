{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    // Resolve platform-split modules (`MapView.native.tsx` / `MapView.web.tsx`)
    // from a single specifier. Native is the primary type surface; the web file
    // is still type-checked in its own right.
    "moduleSuffixes": [".ios", ".android", ".native", ""],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "plugins/**/*.ts",
    "e2e/**/*.ts",
    "app.config.ts",
    ".eslintrc.js",
    "eslint.config.mjs",
    "babel.config.js",
    "jest.config.js",
    "playwright.config.ts"
  ]
}
