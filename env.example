# ---- Public (bundled into the app; safe only because RLS + key restrictions protect them) ----
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase's dashboard names the browser-safe key EXPO_PUBLIC_SUPABASE_KEY in its
# React Native quickstart, and this repo has always named it ..._ANON_KEY. Either
# works (config.ts falls back), and the value is the same publishable/anon key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_SUPABASE_KEY=

# Mappls map SDK key — restrict it in the Mappls console to your Android package
# (com.nammalorry.driver), iOS bundle id (com.nammalorry.driver) and the web domain (audit ND-2).
# Used by the web map (Mappls Web Maps JS SDK).
EXPO_PUBLIC_MAPPLS_MAP_SDK_KEY=

# ---- Clerk (public half) ----
# NOT wired to any sign-in screen yet — driver auth is still Supabase phone
# OTP (docs/PHASE1_TASKS.md 2026-10-04). The publishable key is not a secret
# (Clerk's own client SDK ships with it), but it must match CLERK_SECRET_KEY
# below, which is why both are also read server-side (src/server/config.ts).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ---- Privacy policy (M9, docs/09 §1) ----
# The published policy URL. D1 shows the link only when this is set, so until the
# policy is published the notice stands on its own text (docs/release/PRIVACY_POLICY.md).
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# ---- Store links (M5) ----
# Shown on the S4 "trips run on the mobile app" notice. Leave empty until the
# app is published (M12c); the notice hides the store buttons while unset.
EXPO_PUBLIC_ANDROID_STORE_URL=
EXPO_PUBLIC_IOS_STORE_URL=

# ---- Mappls native licensing files (M3) ----
# The native SDK (mappls-map-react-native) authenticates with files downloaded
# per app from https://auth.mappls.com/console (Package Name + signing SHA-256 /
# bundle id), NOT with the key above. They are gitignored secrets — place them as:
#   mappls/android/<appId>.a.olf   mappls/android/<appId>.a.conf
#   mappls/ios/<appId>.i.olf       mappls/ios/<appId>.i.conf
# plugins/withMappls.ts copies them during `expo prebuild` (Android maven repo +
# app/ module files, iOS Podfile post_install + Copy Bundle Resources).

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Sentry DSN for the app bundle (@sentry/react-native + web). Wired in B4 (ND-11);
# empty = crash reporting off.
EXPO_PUBLIC_SENTRY_DSN=

# ---- Server-only (Supabase Edge Function secrets — NEVER in the app bundle) ----
# set with: supabase secrets set KEY=value
# Mappls map SDK key and the native .olf/.conf licensing files are NOT these —
# see the M3 block above.
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
MAPPLS_REST_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Transactional email (src/server/email, server-only). The key is a secret:
# never an EXPO_PUBLIC_* variable. EMAIL_FROM is a sender on a domain verified
# in Resend, e.g. "Namma Lorry <no-reply@mail.example.com>" (not @resend.dev).
RESEND_API_KEY=
EMAIL_FROM=

# ---- Neon (server-only; src/server/db.ts) ----
# Not queried yet — nothing has moved off Supabase's Postgres. Set only when
# wiring a Cloudflare Pages Function that needs it.
DATABASE_URL=

# ---- Clerk (server-only half; src/server/clerk.ts) ----
# Must match EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY above. Not used by any route
# yet — see the note on that variable.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ---- Cloudflare R2 (server-only; src/server/storage.ts) ----
# Scoped to one private bucket; the app never gets these keys, only a
# short-lived signed URL. Not called from any upload flow yet.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Sentry source-map upload at build time (EAS secrets; app.config.ts adds the
# @sentry/react-native/expo plugin only when the token is set).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
