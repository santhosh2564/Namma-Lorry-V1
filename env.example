# ---- Public (bundled into the app; safe only because RLS + key restrictions protect them) ----
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mappls map SDK key — restrict it in the Mappls console to your Android package, iOS bundle id and web domain (audit ND-2)
EXPO_PUBLIC_MAPPLS_MAP_SDK_KEY=

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Sentry DSN for the app bundle (@sentry/react-native + web). Wired in M12a (ND-11).
EXPO_PUBLIC_SENTRY_DSN=

# ---- Server-only (Supabase Edge Function secrets — NEVER in the app bundle) ----
# set with: supabase secrets set KEY=value
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
MAPPLS_REST_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SENTRY_AUTH_TOKEN=
