# Expo SDK 57 template peers (react-server-dom-webpack, jest presets) don't resolve strictly.
legacy-peer-deps=true
# Do NOT set `os=` here (R0). The M1 scaffold had `os=win32`: a no-op on Windows (npm already
# uses process.platform) but on Linux — GitHub CI, Vercel, EAS build workers — it installs the
# Windows native binaries (lightningcss, @unrs/resolver-binding) instead of the Linux ones.
