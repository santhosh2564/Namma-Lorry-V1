-- Shared pgTAP helpers. Included from each *.test.sql with `\ir _helpers.psql`
-- inside that file's transaction, so everything here is rolled back afterwards.
-- The .psql extension keeps `supabase test db` (pg_prove) from running it as a test.

create extension if not exists pgtap with schema extensions;
create schema tests;
grant usage on schema tests to authenticated, anon;

-- Act as a signed-in user (auth.uid() = p_id) under the `authenticated` role.
create function tests.as_user(p_id uuid) returns void language plpgsql as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config('request.jwt.claim.sub', p_id::text, true);
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_id, 'role', 'authenticated')::text, true);
end $$;

-- Act as an anonymous client (anon key, no session).
create function tests.as_anon() returns void language plpgsql as $$
begin
  perform set_config('role', 'anon', true);
  perform set_config('request.jwt.claim.sub', '', true);
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
end $$;

-- Back to the test runner's role (postgres) with no JWT; bypasses RLS for setup.
create function tests.as_postgres() returns void language plpgsql as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claim.sub', '', true);
  perform set_config('request.jwt.claims', '', true);
end $$;

-- auth user + profile (profile row comes from the handle_new_user trigger).
create function tests.create_user(p_id uuid, p_phone text, p_role public.user_role, p_name text)
returns uuid language plpgsql as $$
begin
  insert into auth.users (instance_id, id, aud, role, phone, phone_confirmed_at, created_at, updated_at)
  values ('00000000-0000-0000-0000-000000000000', p_id, 'authenticated', 'authenticated',
          p_phone, now(), now(), now());
  update public.profiles set role = p_role, full_name = p_name where id = p_id;
  return p_id;
end $$;

create function tests.create_vehicle(p_reg text, p_owner uuid default null) returns uuid
language sql as $$
  insert into public.vehicles (registration_no, vehicle_type, owner_id)
  values (p_reg, '19ft', p_owner) returning id
$$;

-- Test route: Sriperumbudur SIPCOT → Vellore (~88 km straight line).
-- planned_distance_m defaults to the straight-line distance so a straight
-- simulated track has planned_ratio ≈ 1.0.
create function tests.create_load(
  p_shipper uuid default null,
  p_pickup_lat double precision default 12.9563, p_pickup_lng double precision default 79.9422,
  p_drop_lat   double precision default 12.9165, p_drop_lng   double precision default 79.1325)
returns uuid language sql as $$
  insert into public.loads (pickup_address, pickup_lat, pickup_lng, drop_address, drop_lat, drop_lng,
                            planned_distance_m, shipper_id)
  values ('Test pickup', p_pickup_lat, p_pickup_lng, 'Test drop', p_drop_lat, p_drop_lng,
          round(extensions.st_distance(
            extensions.st_setsrid(extensions.st_makepoint(p_pickup_lng, p_pickup_lat), 4326)::extensions.geography,
            extensions.st_setsrid(extensions.st_makepoint(p_drop_lng, p_drop_lat), 4326)::extensions.geography)),
          p_shipper)
  returning id
$$;

create function tests.create_trip(p_load uuid, p_driver uuid, p_vehicle uuid) returns uuid
language sql as $$
  insert into public.trips (load_id, driver_id, vehicle_id) values (p_load, p_driver, p_vehicle) returning id
$$;

-- Evenly spaced points from the load's pickup to its drop:
-- point g (1..p_total) is recorded at p_start + g * p_step, at fraction g/p_total of the line.
-- Only seqs p_from..p_to are inserted (to simulate partial uploads).
create function tests.insert_track(p_trip uuid, p_start timestamptz, p_step interval,
                                   p_total int, p_from int default 1, p_to int default null,
                                   p_accuracy real default 10)
returns void language sql as $$
  insert into public.trip_points (trip_id, seq, recorded_at, lat, lng, accuracy_m, speed_mps)
  select p_trip, g, p_start + g * p_step,
         l.pickup_lat + (l.drop_lat - l.pickup_lat) * g / p_total::double precision,
         l.pickup_lng + (l.drop_lng - l.pickup_lng) * g / p_total::double precision,
         p_accuracy, 12
  from public.trips t join public.loads l on l.id = t.load_id,
       generate_series(p_from, coalesce(p_to, p_total)) g
  where t.id = p_trip
$$;

-- A finished trip ready for verify_trip: started at the pickup 2 h ago, ended at the
-- drop now, 240 points every 30 s (120/h), all uploaded. With no changes it verifies clean.
-- Points are inserted while in_progress so the upload trigger does not verify early.
create function tests.completed_trip(p_driver uuid, p_vehicle uuid,
                                     p_duration interval default interval '2 hours',
                                     p_points int default 240)
returns uuid language plpgsql as $$
declare v_load uuid; v_trip uuid; l public.loads;
begin
  v_load := tests.create_load();
  select * into l from public.loads where id = v_load;
  v_trip := tests.create_trip(v_load, p_driver, p_vehicle);
  update public.trips set status = 'in_progress', started_at = now() - p_duration,
         start_lat = l.pickup_lat, start_lng = l.pickup_lng, start_accuracy_m = 10
   where id = v_trip;
  perform tests.insert_track(v_trip, now() - p_duration, p_duration / p_points, p_points);
  update public.trips set status = 'completed', ended_at = now(),
         end_lat = l.drop_lat, end_lng = l.drop_lng, end_accuracy_m = 10,
         expected_points = p_points
   where id = v_trip;
  delete from public.trip_live where trip_id = v_trip;
  return v_trip;
end $$;

-- ---------- Real routes (M12b acceptance) ----------
-- Same waypoints as test/gpx/routes.json (checked by src/__tests__/gpxRoutes.test.ts).
create function tests.route(p_id text) returns extensions.geometry language sql immutable as $$
  select extensions.st_setsrid(extensions.st_makeline(case p_id
    when 'sriperumbudur-coimbatore' then array[
    extensions.st_makepoint(79.9422, 12.9563),
    extensions.st_makepoint(79.9419, 12.9675),
    extensions.st_makepoint(79.8216, 12.9869),
    extensions.st_makepoint(79.4636, 12.9056),
    extensions.st_makepoint(79.3667, 12.9254),
    extensions.st_makepoint(79.1325, 12.9165),
    extensions.st_makepoint(78.9431, 12.9061),
    extensions.st_makepoint(78.7166, 12.7904),
    extensions.st_makepoint(78.6208, 12.682),
    extensions.st_makepoint(78.2137, 12.5186),
    extensions.st_makepoint(78.219, 12.4209),
    extensions.st_makepoint(78.1579, 12.1277),
    extensions.st_makepoint(78.0591, 11.9407),
    extensions.st_makepoint(78.045, 11.7447),
    extensions.st_makepoint(78.146, 11.6643),
    extensions.st_makepoint(77.8688, 11.4745),
    extensions.st_makepoint(77.6887, 11.4404),
    extensions.st_makepoint(77.5858, 11.2753),
    extensions.st_makepoint(77.405, 11.165),
    extensions.st_makepoint(77.2684, 11.1929),
    extensions.st_makepoint(77.087, 11.066),
    extensions.st_makepoint(76.9656, 10.9608)]
    when 'hosur-peenya' then array[
    extensions.st_makepoint(77.8233, 12.7392),
    extensions.st_makepoint(77.796, 12.765),
    extensions.st_makepoint(77.7717, 12.7797),
    extensions.st_makepoint(77.7074, 12.8027),
    extensions.st_makepoint(77.693, 12.815),
    extensions.st_makepoint(77.6602, 12.8452),
    extensions.st_makepoint(77.596, 12.851),
    extensions.st_makepoint(77.543, 12.871),
    extensions.st_makepoint(77.487, 12.912),
    extensions.st_makepoint(77.454, 12.969),
    extensions.st_makepoint(77.476, 13.056),
    extensions.st_makepoint(77.518, 13.044),
    extensions.st_makepoint(77.5273, 13.0329)]
  end), 4326)
$$;

create function tests.route_length_m(p_id text) returns double precision language sql immutable as $$
  select extensions.st_length(tests.route(p_id)::extensions.geography)
$$;

-- Load along a route: pickup/drop = first/last waypoint. planned_distance_m defaults to the
-- route length (stand-in for the Mappls planned route).
create function tests.route_load(p_id text, p_planned_m int default null) returns uuid language sql as $$
  insert into public.loads (pickup_address, pickup_lat, pickup_lng, drop_address, drop_lat, drop_lng, planned_distance_m)
  select 'Pickup ' || p_id, extensions.st_y(extensions.st_startpoint(r)), extensions.st_x(extensions.st_startpoint(r)),
         'Drop ' || p_id,   extensions.st_y(extensions.st_endpoint(r)),   extensions.st_x(extensions.st_endpoint(r)),
         coalesce(p_planned_m, round(tests.route_length_m(p_id))::int)
  from tests.route(p_id) r
  returning id
$$;

-- Position at fraction f (0..1) of a route, as (lat, lng).
create function tests.route_at(p_id text, f double precision, out lat double precision, out lng double precision)
language sql immutable as $$
  select extensions.st_y(p), extensions.st_x(p)
  from extensions.st_lineinterpolatepoint(tests.route(p_id), greatest(0, least(1, f))) p
$$;

-- Upload points the way the phone would (runs as the caller, so RLS applies to drivers).
-- Point g of p_total is recorded at p_start + g*p_step at fraction (g/p_total)*p_end_fraction
-- of the route; seqs p_from..p_to only; p_noise_m adds deterministic lateral GPS jitter;
-- p_skip_from..p_skip_to are slots never uploaded; p_mock_seq marks one point mocked.
-- p_seq_offset: seq = slot - offset. A killed app records nothing, so after a restart seq
-- continues from where it stopped while time and position have moved on.
create function tests.upload_route(
  p_trip uuid, p_id text, p_start timestamptz, p_step interval, p_total int,
  p_from int default 1, p_to int default null, p_noise_m double precision default 0,
  p_end_fraction double precision default 1, p_skip_from int default null, p_skip_to int default null,
  p_mock_seq int default null, p_accuracy real default 8, p_seq_offset int default 0)
returns int language sql as $$
  with ins as (
    insert into public.trip_points (trip_id, seq, recorded_at, lat, lng, accuracy_m, speed_mps, heading, is_mocked)
    select p_trip, g - p_seq_offset, p_start + g * p_step,
           pos.lat + (p_noise_m / 111320.0) * sin(g * 12.9898),
           pos.lng + (p_noise_m / 111320.0) * cos(g * 78.233),
           p_accuracy, 11, 0, g - p_seq_offset = coalesce(p_mock_seq, -1)
    from generate_series(p_from, coalesce(p_to, p_total)) g,
         tests.route_at(p_id, g::double precision / p_total * p_end_fraction) pos
    where g not between coalesce(p_skip_from, 0) and coalesce(p_skip_to, -1)
    returning 1)
  select count(*)::int from ins
$$;

grant execute on all functions in schema tests to authenticated, anon;
